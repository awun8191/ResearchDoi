APP_ENV=development
API_KEY=*** Required in production — set a long random secret
OPENROUTER_API_KEY=sk-or-...
UNPAYWALL_EMAIL=app@yourdomain.com

# ── Legacy Firebase (being migrated to Appwrite) ─────────────────────────────
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# FIREBASE_STORAGE_BUCKET=researchassistant-3446d.firebasestorage.app

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS.
# Add your production domain here once deployed.
CORS_ORIGINS=http://localhost:5173

# ── OpenRouter model overrides ──────────────────────────────────────────────
# Defaults: Gemma 4 31B for chat, Qwen3 Embedding 8B for embeddings
# CHAT_MODEL=google/gemma-4-31b-it
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ── ADK Agent (Rast-Agent) ──────────────────────────────────────────────────
# AGENT_BASE_URL=http://localhost:8000
